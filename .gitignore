node_modules
dist
.DS_Store
*.log
.vite

# Per-user Claude Code overrides — should not be committed
.claude/settings.local.json

# Transient harness lock file (scheduled-task coordination); not state
# that belongs in the repo.
.claude/scheduled_tasks.lock

# Background-agent isolated worktrees (harness-managed; transient).
# When the user spawns a parallel agent in worktree-isolation mode the
# harness creates `.claude/worktrees/<agent-id>/`; the entries are full
# checkouts and would otherwise leak into git status / biome scan /
# commit selection on the main worktree.
.claude/worktrees/

# Playwright artifacts (`npm run smoke`). The .spec files in `e2e/` ARE
# checked in; only the run output (HTML reporter dump, trace zips,
# screenshots from failed runs) is excluded.
test-results/
playwright-report/
.playwright/
e2e/.artifacts/

# Ad-hoc screenshot dumps from coordinator-driven multi-branch UX
# captures (e.g. visual comparison of layout-constant bumps across
# main + explore branches). Useful while iterating but not checked in.
screenshots-gap-bump/
