# Per-user Claude Code overrides — should not be committed
.claude/settings.local.json

# Playwright artifacts (`npm run smoke`). The .spec files in `e2e/` ARE
# checked in; only the run output (HTML reporter dump, trace zips,
# screenshots from failed runs) is excluded.
test-results/
playwright-report/
.playwright/
# Local screenshot scratchpad emitted by e2e specs that call page.screenshot()
# with a path under e2e/.artifacts/ (e.g. the explore/edge-routing-router
# router smoke). Pixel-by-pixel images on disk shouldn't land in git.
e2e/.artifacts/
